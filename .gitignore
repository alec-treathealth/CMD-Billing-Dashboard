# PHI / secrets — MUST never be committed.
# reports/ holds failed-coercion output which may contain raw cell values (PHI).
reports/
# data/ holds raw CMD batch report CSV pulls (patient-level PHI). Never commit.
data/
# Local CMD report CSV pulls feeding the Collections Explorer seed/cron — patient-level
# PHI (Patient Full Name / Member ID / Group Number). Read by cmdExplorerSeed.ts via
# CMD_EXPLORER_SEED_DIR. NEVER commit the data. *.csv is a blanket guard for the same
# reason (every CSV in this repo is a CMD PHI export); use `git add -f` for a rare
# deliberately-non-PHI csv.
Derek Historical Report Data/
Indigo Cron Job/
# Indigo Seed Data/ holds REAL Indigo patient PHI (CMD batch-dump CSV export). Load into
# Supabase staging.* only — NEVER commit. Its CSVs are already caught by *.csv below; this
# explicit folder entry guards any non-CSV file dropped there (mirrors the two folders above).
Indigo Seed Data/
*.csv
.env
.env.*
!.env.example

# Google service-account credentials (never commit)
*service-account*.json
gcp-*.json

# Node
node_modules/
dist/
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/
secrets/
# Claude Code — keep shared config, hooks + project rules; ignore local-only overrides
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/rules/
.claude/settings.local.json

# VOB ETL (etl/vob/) — Python + PHI-adjacent. PDFs/CSVs are PHI (patient VOB docs); loader.env
# holds the INDEX_HMAC_KEY + DB URLs. Data + PDFs live OUTSIDE the repo, but guard defensively.
# (Incident 2026-07-23: PHI/AWS-key was found in the old public VOB-scripts repo — never again.)
__pycache__/
*.pyc
*.pdf
loader.env
*.env
!.env.example

# Supabase CLI scratch
supabase/.temp/

# Vercel CLI local project link (README.txt + project.json — link metadata only, no secrets)
.vercel/

# Local probe/research output (scripts/payer_intel_probe.ts writes here)
scratch/
